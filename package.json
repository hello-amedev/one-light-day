    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "svelte": "^5.59.0",
